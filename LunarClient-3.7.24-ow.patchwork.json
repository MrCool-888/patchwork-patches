    {
      "id": "disable-auto-updates",
      "name": "Disable automatic updates",
      "category": "Launcher",
      "version": "0.1.0",
      "status": "ready",
      "dependencies": [
        "clean-launcher"
      ],
      "description": "Stops automatic launcher update checks at startup, on timers and after channel changes. Blocks server-requested launcher updates, including force-install requests, and disables installation on app exit. Manual Check for updates remains available; restore patches before updating Lunar. Requires Remove ads and promotions for its launcher archive compatibility change. Game/runtime downloads during Minecraft launch are separate and remain unchanged.",
