          "find": "async checkForUpdates(e){if(e&&(this.userInitiated=e),",
          "replacement": "async checkForUpdates(e){if(!e){this.logger.info(`Automatic launcher updates disabled by Patchwork.`);return}if(e&&(this.userInitiated=e),",
